# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามต้องการ
#   cp .env.example .env
# ทุกค่าขึ้นต้นด้วย XAU_

# ---------------------------------------------------------------
# ความปลอดภัย — ต้องเปลี่ยน!
# ---------------------------------------------------------------
# รหัสผ่านสำหรับเรียก API ตั้งเป็นอะไรก็ได้ที่เดายาก
# สร้างแบบสุ่ม:  python -c "import secrets; print(secrets.token_urlsafe(32))"
XAU_API_TOKEN=change-me

# ---------------------------------------------------------------
# โหมดการเทรด
# ---------------------------------------------------------------
# paper   = จำลอง ไม่ส่งออร์เดอร์จริง (ค่าเริ่มต้น ปลอดภัยที่สุด)
# ea      = ส่งคำสั่งให้ EA ใน MetaTrader 5 ไปเปิดออร์เดอร์
# metaapi = ส่งออร์เดอร์ผ่าน MetaApi cloud โดยตรง
XAU_BROKER=paper

# สวิตช์ใหญ่สำหรับเงินจริง ต้องเป็น true เท่านั้นถึงจะส่งออร์เดอร์จริงได้
# ปล่อยเป็น false ไว้จนกว่าจะทดสอบบนบัญชีเดโมจนมั่นใจแล้ว
XAU_ALLOW_LIVE=false

# ---------------------------------------------------------------
# MetaApi (ใช้เมื่อ XAU_BROKER=metaapi เท่านั้น)
# ---------------------------------------------------------------
XAU_METAAPI_TOKEN=
XAU_METAAPI_ACCOUNT_ID=
XAU_METAAPI_REGION=london

# ---------------------------------------------------------------
# การจัดการความเสี่ยง
# ---------------------------------------------------------------
# เสี่ยงกี่ % ของพอร์ตต่อ 1 ออร์เดอร์ (0.5 = ครึ่งเปอร์เซ็นต์)
XAU_RISK_PERCENT=0.5

# เปิดออร์เดอร์พร้อมกันได้สูงสุดกี่ไม้
XAU_MAX_OPEN_POSITIONS=2

# ขาดทุนถึงกี่ % ของวันแล้วให้หยุดเทรดทันที
XAU_MAX_DAILY_LOSS_PERCENT=3.0

# ถ้าสเปรดกว้างเกินกี่ดอลลาร์ ให้ปฏิเสธการเข้าออร์เดอร์
XAU_MAX_SPREAD_USD=0.60

# รับเฉพาะสัญญาณที่ AI มั่นใจเกินค่านี้ (0.60 = 60%)
XAU_MIN_CONFIDENCE=0.60

# ระยะ stop loss เริ่มต้น (ดอลลาร์) เมื่อสัญญาณไม่ได้ระบุมา
XAU_DEFAULT_SL_USD=3.0

# take profit เป็นกี่เท่าของระยะ stop loss
XAU_DEFAULT_TP_R=1.5

# ขนาดล็อตสูงสุดที่ยอมให้เปิด
XAU_MAX_LOT=5.0

# ---------------------------------------------------------------
# เวลาเทรด (เป็นเวลา UTC — ไทยคือ UTC+7)
# ---------------------------------------------------------------
# ตัวอย่าง: อยากเทรด 14:00-23:00 เวลาไทย ให้ใส่ 07:00-16:00
# ใส่หลายช่วงได้ คั่นด้วยจุลภาค เช่น 07:00-11:00,13:00-16:00
XAU_TRADING_HOURS_UTC=00:00-23:59

# ---------------------------------------------------------------
# อื่นๆ
# ---------------------------------------------------------------
XAU_DB_PATH=xauusd_bot.db
XAU_PAPER_START_BALANCE=10000
XAU_PRICE_FEED=yahoo
XAU_LOG_LEVEL=INFO
