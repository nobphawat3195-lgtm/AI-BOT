          "id": "Prompt-advis02",
          "type": "Prompt",
          "node": {
            "display_name": "Advisor Prompt",
            "description": "Pins the model to a strict, machine-readable answer.",
            "base_classes": ["Message"],
            "documentation": "",
            "beta": false,
            "outputs": [
              {
