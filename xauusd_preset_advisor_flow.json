        "data": {
          "id": "PythonFunction-pub04",
          "type": "PythonFunction",
          "node": {
            "display_name": "Publish To Bridge",
            "description": "Parses the LLM's JSON and POSTs it to the FastAPI bridge. Edit BRIDGE_URL and API_TOKEN below.",
            "base_classes": ["Message"],
            "documentation": "",
            "beta": false,
            "outputs": [
              {
                "types": ["Message"],
                "selected": "Message",
                "name": "output",
                "display_name": "Result",
                "method": "execute"
              }
            ],
            "field_order": ["function_code", "input_value"],
            "template": {
              "_type": "Component",
              "input_value": {
                "type": "str",
                "required": false,
                "show": true,
                "name": "input_value",
                "display_name": "Input",
                "advanced": false,
                "input_types": ["Message"],
                "value": ""
              },
              "function_code": {
                "type": "code",
                "required": true,
                "show": true,
                "multiline": true,
                "name": "function_code",
                "display_name": "Code",
                "advanced": false,
                "value": "import json, re, urllib.request, urllib.error\n\n# --- edit these two -------------------------------------------------\nBRIDGE_URL = \"http://127.0.0.1:8000\"\nAPI_TOKEN  = \"change-me\"\n# --------------------------------------------------------------------\n\ndef publish(text: str) -> str:\n    \"\"\"Parse the model's JSON verdict and forward it to the bridge.\"\"\"\n    raw = str(text).strip()\n    # Models often wrap JSON in code fences; take the first object.\n    match = re.search(r\"\\{.*\\}\", raw, re.S)\n    if not match:\n        return f\"ERROR: no JSON found in model output: {raw[:200]}\"\n    try:\n        verdict = json.loads(match.group(0))\n    except json.JSONDecodeError as exc:\n        return f\"ERROR: bad JSON from model ({exc})\"\n\n    side = str(verdict.get(\"side\", \"\")).upper()\n    if side not in {\"BUY\", \"SELL\", \"HOLD\"}:\n        return f\"ERROR: unexpected side {side!r}\"\n    if side == \"HOLD\":\n        return \"HOLD - nothing sent to the bridge.\"\n\n    payload = {\n        \"symbol\": \"XAUUSD\",\n        \"side\": side,\n        \"confidence\": float(verdict.get(\"confidence\", 0)),\n        \"rationale\": str(verdict.get(\"rationale\", \"\"))[:500],\n        \"source\": \"langflow\",\n    }\n    for key in (\"entry\", \"stop_loss\", \"take_profit\"):\n        value = verdict.get(key)\n        if value not in (None, \"\", 0):\n            payload[key] = float(value)\n\n    request = urllib.request.Request(\n        f\"{BRIDGE_URL}/api/signals\",\n        data=json.dumps(payload).encode(),\n        headers={\"Content-Type\": \"application/json\", \"X-API-Token\": API_TOKEN},\n        method=\"POST\",\n    )\n    try:\n        with urllib.request.urlopen(request, timeout=15) as resp:\n            result = json.loads(resp.read().decode())\n    except urllib.error.HTTPError as exc:\n        return f\"ERROR: bridge returned HTTP {exc.code}: {exc.read().decode()[:200]}\"\n    except urllib.error.URLError as exc:\n        return f\"ERROR: cannot reach the bridge - {exc.reason}\"\n\n    status = \"ACCEPTED\" if result.get(\"accepted\") else \"REJECTED\"\n    return f\"{status}: {result.get('reason', '')}\"\n"
              }
            }
          }
        }
